{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "logwork",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "logwork" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "logwork",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "env": {
    "preview": {
      "name": "logwork-preview",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "logwork-preview" }],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "logwork-preview",
        "database_id": "00000000-0000-0000-0000-000000000000",
        "migrations_dir": "migrations"
      }]
    }
  }
}
